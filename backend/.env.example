# Django
APP_ENV=development
DEBUG=True
DJANGO_SECRET_KEY=replace-locally-with-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/akademi

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_PUBLISHABLE_KEY=replace-locally
SUPABASE_SECRET_KEY=replace-in-backend-only
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage Buckets
SUPABASE_BUCKET_CONTENT=course-content
SUPABASE_BUCKET_SUBMISSIONS=student-submissions
SUPABASE_BUCKET_CANVAS=canvas-documents
SUPABASE_BUCKET_EXPORTS=canvas-exports
SUPABASE_BUCKET_VIDEOS=learning-videos
SUPABASE_BUCKET_CERTIFICATES=certificates

# Mock Providers
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Email (SMTP) — only needed when EMAIL_PROVIDER=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=noreply@akademi.id
# SITE_URL=https://akademi.id

# WhatsApp (Meta Cloud API) — only needed when WHATSAPP_PROVIDER=wa_cloud_api
# WHATSAPP_API_TOKEN=your-waba-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Midtrans Payment
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
# MIDTRANS_PRODUCTION=false

# Development Seeds
SEED_PASSWORD=dev-password-2026
