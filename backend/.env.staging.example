# AKADEMI Staging Environment Template
# Copy to .env.staging and fill in values before deploying
# NEVER commit the real .env.staging to git

# ── Django Backend ──────────────────────────────────────────
DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
DJANGO_ALLOWED_HOSTS=akademi-staging-api.up.railway.app,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://akademi-staging.vercel.app,http://localhost:5173

# ── Database (Railway PostgreSQL addon) ─────────────────────
DATABASE_URL=postgresql://user:password@host:5432/akademi_staging

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://stfrztjpunetsekovlsk.supabase.co
SUPABASE_PROJECT_REF=stfrztjpunetsekovlsk
SUPABASE_PUBLISHABLE_KEY=<copy from Supabase Dashboard → Settings → API>
SUPABASE_SECRET_KEY=<copy from Supabase Dashboard → Settings → API>
SUPABASE_JWKS_URL=https://stfrztjpunetsekovlsk.supabase.co/auth/v1/.well-known/jwks.json

# ── Redis (Railway Redis addon) ────────────────────────────
REDIS_URL=redis://default:password@host:6379/0
CELERY_BROKER_URL=redis://default:password@host:6379/0
CELERY_RESULT_BACKEND=redis://default:password@host:6379/1

# ── Providers (staging = mock) ─────────────────────────────
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ── Seed ────────────────────────────────────────────────────
SEED_PASSWORD=dev-password-2026
